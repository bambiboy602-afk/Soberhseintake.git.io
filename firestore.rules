rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(residentId) { return isSignedIn() && request.auth.uid == residentId; }
    
    function isValidResident(data) {
      return data.fullName is string && data.fullName.size() > 0
          && data.email is string && data.email.size() > 0
          && data.status is string
          && (data.onboardingStep is int || data.onboardingStep == null);
    }

    match /residents/{residentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidResident(request.resource.data);
      allow update: if isSignedIn() && isValidResident(request.resource.data);
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
